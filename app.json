{
  "expo": {
    "name": "Inbox And Campaigns",
    "slug": "inbox-and-campaigns",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "inboxcampaign",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "supportsTablet": false,
      "bundleIdentifier": "com.inbox.campaign",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationQueriesSchemes": [
          "whatsapp"
        ],
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "package": "com.inbox.campaign",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#4F46E5",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE",
        "android.permission.INTERNET",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "blockedPermissions": [
        "android.permission.CALL_PHONE",
        "android.permission.READ_CALL_LOG",
        "android.permission.READ_PHONE_STATE",
        "android.permission.WRITE_CONTACTS"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1B1464",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "dark": {
            "backgroundColor": "#0F0B3D"
          }
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#4F3FE0",
          "defaultChannel": "messages"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-localization",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Inbox And Campaigns to use the camera to scan your Access ID QR code.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Inbox And Campaigns to attach photos to WhatsApp messages."
        }
      ],
      "expo-font",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "dynamic"
          }
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Inbox And Campaigns to record voice notes for WhatsApp.",
          "enableBackgroundPlayback": false
        }
      ],
      "expo-asset",
      "expo-video",
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Inbox And Campaigns to save photos and videos from your chats.",
          "savePhotosPermission": "Allow Inbox And Campaigns to save photos and videos from your chats to your library.",
          "granularPermissions": []
        }
      ],
      [
        "expo-sharing",
        {
          "ios": {
            "enabled": true,
            "activationRule": {
              "supportsText": true,
              "supportsWebUrlWithMaxCount": 1,
              "supportsImageWithMaxCount": 10,
              "supportsMovieWithMaxCount": 10,
              "supportsFileWithMaxCount": 10
            }
          },
          "android": {
            "enabled": true,
            "singleShareMimeTypes": [
              "text/*",
              "image/*",
              "video/*",
              "audio/*",
              "application/*"
            ],
            "multipleShareMimeTypes": [
              "image/*",
              "video/*",
              "audio/*",
              "application/*"
            ]
          }
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Allow Inbox And Campaigns to read your contacts so you can add them to your CRM. You choose automatic or manual sync, and can block contacts from ever being added."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "e1066f40-24da-4b2f-9be5-1b64778bd990"
      }
    },
    "owner": "aksa11"
  }
}
