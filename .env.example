# Copy to `.env` and fill in: cp .env.example .env
# All values are public (Expo bundles EXPO_PUBLIC_* into the app). Never put secrets here.
# Restart `npx expo start` after changing this file.

# --- Required ---------------------------------------------------------------

# SSO (Auth-as-a-Service) origin: the host serving /api/v1/projects/:id/...
EXPO_PUBLIC_SSO_URL=https://sso.example.com

# CPaaS CRM gateway origin
EXPO_PUBLIC_CPASS_BASE_URL=https://cpaas.example.com

# Live inbox socket origin (often the same host as the CPaaS gateway)
EXPO_PUBLIC_INBOX_URL=https://cpaas.example.com

# --- Optional ---------------------------------------------------------------

# Sent as the Origin / Referer header from the phone app (SSO and CPaaS check it),
# and used as the captcha page's domain on phones. Must be allowed on your SSO
# project, CPaaS and captcha key.
EXPO_PUBLIC_APP_ORIGIN=http://localhost

# One Access ID only: set this to lock the app to a single workspace project.
# Sign-in then starts at the login screen; the Access ID screen, its QR codes and
# "Change Access ID" never show, and every account uses this id.
# Leave empty to let users enter an Access ID per account (the default).
EXPO_PUBLIC_ACCESS_ID=

# Default Access ID (project id) pre-filled on the sign-in screen. Users can type
# their own, so this may stay empty. EXPO_PUBLIC_SSO_PROJECT_ID is an older name
# for the same value.
EXPO_PUBLIC_SDK_CLIENT_ID=
EXPO_PUBLIC_SSO_PROJECT_ID=

# Web push only: Firebase Console > Project settings > Cloud Messaging >
# Web Push certificates > Key pair
EXPO_PUBLIC_FIREBASE_VAPID_KEY=
